{% extends "@core/module-layout.twig" %}
{% block module_content %}
<header class="rhapsody-page-header">
    <h1 class="rhapsody-title">Redirects</h1>
</header>

<div class="rhapsody-card">
    <form class="rhapsody-form rhapsody-form--inline" method="post" action="/seo-toolkit-pro/redirects">
        {{ csrf_field()|raw }}
        <input type="text" class="rhapsody-input" name="source_path" placeholder="/old-path" required>
        <input type="text" class="rhapsody-input" name="target_path" placeholder="/new-path" required>
        <select class="rhapsody-select" name="status_code"><option value="301">301</option><option value="302">302</option></select>
        <button type="submit" class="rhapsody-btn">Add redirect</button>
    </form>
</div>

<div class="rhapsody-table-wrap">
    <table class="rhapsody-table">
        <thead><tr><th>Source</th><th>Target</th><th>Status</th><th>Hits</th><th></th></tr></thead>
        <tbody>
        {% for r in redirects %}
            <tr>
                <td>{{ r.source_path }}</td>
                <td>{{ r.target_path }}</td>
                <td>{{ r.status_code }}</td>
                <td>{{ r.hit_count }}</td>
                <td>
                    <form class="rhapsody-form rhapsody-form--inline" method="post" action="/seo-toolkit-pro/redirects/{{ r.id }}/delete">
                        {{ csrf_field()|raw }}
                        <button type="submit" class="rhapsody-btn rhapsody-btn--danger rhapsody-btn--sm">Delete</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="rhapsody-muted">No redirects yet.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
